# ==============================================================================
# WebAudits PRO / VitalsSniper Environment Configuration
# Copy these to Vercel Project Settings -> Environment Variables (Day 5 of Plan)
# ==============================================================================

# Site URL
NEXT_PUBLIC_SITE_URL=https://webaudits.pro

# Email Infrastructure (Day 3 - Resend)
RESEND_API_KEY=re_your_resend_api_key_here

# Database Infrastructure (Day 4 - Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Payment Gateway (Day 6 - 2Checkout / Verifone)
CHECKOUT_MERCHANT_CODE=your_2checkout_merchant_code
CHECKOUT_MERCHANT_KEY=your_2checkout_secret_key

# AppSumo Partner URL
NEXT_PUBLIC_APPSUMO_URL=https://appsumo.com/products/vitalssniper
